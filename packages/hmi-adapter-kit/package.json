{
  "name": "@axrail/hmi-adapter-kit",
  "version": "0.2.0-alpha.1",
  "description": "Vendor-neutral HMI domain Adapter kit for Axrail.",
  "license": "Apache-2.0",
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Kucell/axrail.git",
    "directory": "packages/hmi-adapter-kit"
  },
  "scripts": {
    "build": "tsc -b tsconfig.build.json",
    "clean": "tsc -b tsconfig.build.json --clean"
  },
  "dependencies": {
    "@axrail/adapter-sdk": "workspace:*",
    "@axrail/artifacts": "workspace:*",
    "@axrail/tools": "workspace:*"
  }
}
