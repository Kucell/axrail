    "directory": "packages/model-ai-sdk"
  },
  "scripts": {
    "build": "tsc -b tsconfig.build.json",
    "clean": "tsc -b tsconfig.build.json --clean"
  },
  "dependencies": {
    "@axrail/agent": "workspace:*",
    "ai": "^7.0.0",
    "@types/json-schema": "^7.0.15"
  }
}
