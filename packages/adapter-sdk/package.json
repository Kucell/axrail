{
  "name": "@axrail/adapter-sdk",
  "version": "0.2.0-alpha.1",
  "description": "Vendor-neutral engineering-system Adapter SDK for Axrail.",
  "license": "Apache-2.0",
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./host": {
      "types": "./dist/host.d.ts",
      "import": "./dist/host.js"
    },
    "./registry": {
      "types": "./dist/registry.d.ts",
      "import": "./dist/registry.js"
    },
    "./context-registry": {
      "types": "./dist/context-registry.d.ts",
      "import": "./dist/context-registry.js"
    }
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Kucell/axrail.git",
    "directory": "packages/adapter-sdk"
  },
  "scripts": {
    "build": "tsc -b tsconfig.build.json",
    "clean": "tsc -b tsconfig.build.json --clean"
  },
  "dependencies": {
    "@axrail/approval": "workspace:*",
    "@axrail/artifacts": "workspace:*",
    "@axrail/policy": "workspace:*",
    "@axrail/tools": "workspace:*",
    "@axrail/transactions": "workspace:*",
    "@axrail/validation": "workspace:*"
  }
}
